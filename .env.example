# Copy this file to `.env` and fill in real values. `.env` is gitignored:
# never commit credentials.

# Pooled PostgreSQL connection used by the app at runtime.
# On Neon, this is the connection string whose host contains "-pooler".
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Direct (non-pooled) connection used by the Prisma CLI for migrations and seeding.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Optional. Absolute site URL used for metadata, sitemap.xml and robots.txt.
# On Vercel this is detected automatically; set it only for a custom domain.
# NEXT_PUBLIC_SITE_URL="https://collegecompass.example.com"
